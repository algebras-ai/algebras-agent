{
  "name": "algebras-agent",
  "description": "AI translation workflow — automated QA and fluency scoring via Algebras",
  "version": "0.0.1",
  "author": {
    "name": "Algebras",
    "email": "support@algebras.ai"
  },
  "homepage": "https://platform.algebras.ai",
  "license": "MIT",
  "userConfig": {
    "algebras_api_key": {
      "type": "string",
      "title": "Algebras API Key",
      "description": "API key from https://platform.algebras.ai/api-keys",
      "sensitive": true
    },
    "algebras_platform_url": {
      "type": "string",
      "title": "Algebras Platform URL",
      "description": "Platform URL (default: https://platform.algebras.ai)",
      "default": "https://platform.algebras.ai"
    }
  },
  "mcpServers": {
    "algebras": {
      "type": "http",
      "url": "${user_config.algebras_platform_url}/api/mcp",
      "headers": {
        "x-api-key": "${user_config.algebras_api_key}"
      }
    }
  }
}
