{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/algebras-ai/algebras-agent/plugin/capture/manifest.schema.json",
  "title": "Algebras screenshot capture manifest",
  "description": "One capture run: the screenshots it produced and the source strings linked to each. Source of truth for the platform importer (T0 Screenshot / ScreenshotString). Version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "runId", "game", "build", "language", "resolution", "capturedAt", "screenshots"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "game": { "type": "string", "minLength": 1 },
    "steamAppId": { "type": "string", "pattern": "^[0-9]+$" },
    "build": { "type": "string", "minLength": 1, "description": "Build id or version of the captured client; 'unknown' when it cannot be read." },
    "language": { "type": "string", "minLength": 2, "maxLength": 35, "description": "BCP 47 language of the UI shown in the screenshots." },
    "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "keyPattern": {
      "type": "string",
      "pattern": "\\{row\\}",
      "description": "How a row number maps to a ProjectString.externalKey, e.g. 'segments.json#row-{row}'."
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "input": { "type": "string" },
        "capture": { "type": "string" }
      }
    },
    "screenshots": {
      "type": "array",
      "items": { "$ref": "#/$defs/screenshot" }
    },
    "extra": { "type": "object", "description": "Free-form run metadata; importers ignore it." }
  },
  "$defs": {
    "screenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "checkpoint", "stringKeys", "rows", "match", "sendToAi"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+\\.(png|jpg|jpeg|webp)$",
          "description": "Image path relative to the manifest's directory."
        },
        "checkpoint": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "stringKeys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "ProjectString.externalKey values shown on this screenshot."
        },
        "rows": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Row numbers of the same strings, when the source is row-based."
        },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "confidence"],
          "properties": {
            "method": { "type": "string", "minLength": 1, "description": "e.g. 'ocr-tesseract+fuzzy', 'expected', 'manual', 'none'." },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "perKey": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "score"],
                "properties": {
                  "key": { "type": "string" },
                  "row": { "type": "integer" },
                  "score": { "type": "number", "minimum": 0, "maximum": 1 },
                  "ocrText": { "type": "string" }
                }
              }
            }
          }
        },
        "sendToAi": { "type": "boolean" }
      }
    }
  }
}
